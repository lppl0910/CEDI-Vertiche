# Puerto del servidor (opcional, default: 3001)
PORT=3001

# URI de MongoDB — descomenta y rellena cuando tengas una base de datos:
# MongoDB local:
# MONGODB_URI=mongodb://localhost:27017/vertiche-rfid
#
# MongoDB Atlas (nube):
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/vertiche-rfid
#
# Si no se configura, el servidor usa almacenamiento en memoria (datos se pierden al reiniciar).
# MONGODB_URI=
