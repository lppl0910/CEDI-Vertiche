# Supabase (public keys — safe to expose in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend service URLs — must point to production servers at build time
VITE_AUTH_API_URL=http://<ec2-or-host>:3003
VITE_MONITOREO_API_URL=http://<ec2-or-host>:3002
VITE_RFID_API_URL=http://<ec2-or-host>:3001
VITE_VENTAS_API_URL=http://<ec2-or-host>:8080
VITE_CHATBOT_API_URL=http://<ec2-or-host>:8090

# RFID service API key
VITE_API_KEY=your-rfid-api-key
